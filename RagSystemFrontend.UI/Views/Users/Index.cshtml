@model List<UserDto>
@{
    ViewData["Title"] = "Utenti";
}

<h1 class="mb-4">Utenti del tenant "@User.TenantSlug()"</h1>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Crea un nuovo utente</h5>
        <form asp-controller="Users" asp-action="Create" method="post" class="row g-2 align-items-start">
            <div class="col-auto">
                <label class="form-label" for="createEmail">Email</label>
                <input type="email" id="createEmail" name="Email" class="form-control" required />
            </div>
            <div class="col-auto">
                <label class="form-label" for="createFullName">Nome completo</label>
                <input type="text" id="createFullName" name="FullName" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label" for="createPassword">Password</label>
                <input type="password" id="createPassword" name="Password" class="form-control" required minlength="12" />
                <div class="form-text">Minimo 12 caratteri.</div>
            </div>
            <div class="col-auto">
                <label class="form-label" for="createRole">Ruolo</label>
                <select id="createRole" name="Role" class="form-select">
                    <option value="user" selected>user</option>
                    <option value="admin">admin</option>
                    <option value="viewer">viewer</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Crea</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Nessun utente trovato.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Email</th>
                <th>Nome</th>
                <th>Ruolo</th>
                <th>Stato</th>
                <th class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr class="">
                    <td>@user.Email</td>
                    <td>@user.FullName</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge text-bg-success">attivo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">disattivato</span>
                        }
                    </td>
                    <td class="text-end">
                        <form asp-controller="Users" asp-action="Delete" method="post" onsubmit="return confirm('Disattivare questo utente?');">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Disattiva</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@model JobsIndexViewModel
@{
    ViewData["Title"] = "Job di ingestione";
    var statuses = new[] { "queued", "running", "done", "failed", "cancelled" };
}

<h1 class="mb-4">Job di ingestione</h1>

<form asp-controller="Jobs" asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label" for="filterStatus">Stato</label>
        <select id="filterStatus" name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Tutti</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(s == Model.Status)">@s</option>
            }
        </select>
    </div>
</form>

@if (Model.Jobs.Items.Count == 0)
{
    <p class="text-muted">Nessun job trovato.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Documento</th>
                <th>Stato</th>
                <th>Tentativi</th>
                <th>Creato il</th>
                <th>Completato il</th>
                <th class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.Jobs.Items)
            {
                <tr>
                    <td><a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id"><code>@job.DocumentId</code></a></td>
                    <td>
                        <span class="badge @(job.Status switch
                                               {
                                                   "done" => "text-bg-success",
                                                   "failed" => "text-bg-danger",
                                                   "cancelled" => "text-bg-secondary",
                                                   "running" => "text-bg-info",
                                                   _ => "text-bg-warning",
                                               })">@job.Status</span>
                    </td>
                    <td>@job.RetryCount</td>
                    <td>@job.CreatedAt.LocalDateTime.ToString("g")</td>
                    <td>@(job.FinishedAt?.LocalDateTime.ToString("g") ?? "-")</td>
                    <td class="text-end">
                        @if (User.IsTenantAdmin() && (job.Status == "queued" || job.Status == "running"))
                        {
                            <form asp-controller="Jobs" asp-action="Cancel" method="post" onsubmit="return confirm('Annullare questo job?');" class="d-inline">
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Annulla</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="Jobs" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-status="@Model.Status">Precedente</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Pagina @Model.Page</span></li>
            <li class="page-item @(!Model.Jobs.HasMore ? "disabled" : "")">
                <a class="page-link" asp-controller="Jobs" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-status="@Model.Status">Successiva</a>
            </li>
        </ul>
    </nav>
}

@model List<TenantDto>
@{
    ViewData["Title"] = "Gestione uffici";
}

<h1 class="mb-4">Gestione uffici (superadmin)</h1>
<p class="text-muted">
    A differenza dei "I miei Space" (dove chi crea l'ufficio ne diventa automaticamente admin) qua crei <strong>uffici (spaces)</strong> che non devono appartenere a un singolo owner, o che richiedono un piano diverso da "starter" fin dalla creazione. Questa sezione è visibile solo ai SuperAdmin (l'unico che amministra l'intera piattaforma).
</p>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Crea un nuovo ufficio</h5>
        <form asp-controller="AdminTenants" asp-action="Create" method="post" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label" for="createDisplayName">Nome ufficio</label>
                <input type="text" id="createDisplayName" name="DisplayName" class="form-control" required maxlength="255" placeholder="es. Filiale Torino" />
                <div class="form-text">Lo slug (es. <code>filiale-torino</code>) viene generato automaticamente da questo nome.</div>
            </div>
            <div class="col-auto">
                <label class="form-label" for="createPlan">Piano</label>
                <select id="createPlan" name="Plan" class="form-select">
                    <option value="starter" selected>starter</option>
                    <option value="pro">pro</option>
                    <option value="enterprise">enterprise</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label" for="createAdminEmail">Email admin (opzionale)</label>
                <input type="email" id="createAdminEmail" name="AdminEmail" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label" for="createAdminPassword">Password admin (opzionale)</label>
                <input type="password" id="createAdminPassword" name="AdminPassword" class="form-control" minlength="12" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Crea</button>
            </div>
        </form>
        <p class="text-muted small mt-2 mb-0">
            Nota: se ometti email e password admin, il tenant viene creato senza utente admin
            (andrà aggiunto separatamente). Se le compili, devono rispettare le stesse regole
            di <code>POST /users</code>: email in formato valido e password di almeno 12 caratteri.
        </p>
    </div>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Nessun ufficio presente.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Slug (ufficio)</th>
                <th>Nome</th>
                <th>Piano</th>
                <th>Stato</th>
                <th>Creato il</th>
                <th class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in Model)
            {
                <tr>
                    <td><code>@tenant.Slug</code></td>
                    <td>@tenant.DisplayName</td>
                    <td>@tenant.Plan</td>
                    <td>
                        @if (tenant.IsActive)
                        {
                            <span class="badge text-bg-success">attivo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">disabilitato</span>
                        }
                    </td>
                    <td>@tenant.CreatedAt.LocalDateTime.ToString("g")</td>
                    <td class="text-end">
                        @if (tenant.IsActive)
                        {
                            <form asp-controller="AdminTenants" asp-action="Disable" method="post" onsubmit="return confirm('Disabilitare questo tenant?');">
                                <input type="hidden" name="slug" value="@tenant.Slug" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Disabilita</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
